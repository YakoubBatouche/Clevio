{
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Frame-Options", "value": "DENY" }]
    },
    {
      "source": "/uploads/:path*",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; sandbox" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
